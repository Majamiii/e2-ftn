#include "Filter.h"
#include <iostream>

extern vector<int> in2FilterVector;
extern vector<int> filter2ClipVector;

using namespace std;

//Funkcija za filtriranje ulaznih podataka
RetVal Filter()
{
	size_t size_vec = in2FilterVector.size();

    if (size_vec < 3)
    {
        return RET_ERROR;
    }
    omp_set_num_threads(omp_get_max_threads());
    #pragma omp parallel for
    for (int i = 1; i < size_vec - 1; i++)
    {
        int a = in2FilterVector[i - 1];
        int b = in2FilterVector[i];
        int c = in2FilterVector[i + 1];

        int minVal = a;
        if (b < minVal) minVal = b;
        if (c < minVal) minVal = c;

        int maxVal = a;
        if (b > maxVal) maxVal = b;
        if (c > maxVal) maxVal = c;

        int range = maxVal - minVal;

        if (i < size_vec - 2) {
            filter2ClipVector[i - 1] = range;
        }

    }

    return RET_OK;
}
