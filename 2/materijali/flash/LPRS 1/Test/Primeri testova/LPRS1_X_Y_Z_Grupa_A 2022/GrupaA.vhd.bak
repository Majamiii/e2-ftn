			oGREAT	: out std_logic;
			oCNTP 	: out std_logic_vector(3 downto 0);
			oCNTN 	: out std_logic_vector(3 downto 0)
	);
end entity;

architecture Behavioral of GrupaA is

begin

end Behavioral;
